# Copy to .env. Do not commit .env. Secrets stay empty here.
# Compose reads this file for interpolation and overrides container URLs itself.

# Deploy script. Anvil account 0 is demo account A for a local solo run.
# Leave PRIVATE_KEY empty in git. Anvil prints that development key at startup.
# Never reuse it on Sepolia or mainnet.
PRIVATE_KEY=
ADMIN_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
MANUFACTURER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
RECALLER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Indexer on the host. Compose points the container at postgres and anvil instead.
POSTGRES_USER=proofchain
POSTGRES_PASSWORD=proofchain
POSTGRES_DB=proofchain
DATABASE_URL=postgres://proofchain:proofchain@127.0.0.1:5432/proofchain
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONTRACT_ADDRESS=
START_BLOCK=0
CONFIRMATIONS=0
IPFS_API_URL=http://127.0.0.1:5001
INDEXER_HOST=127.0.0.1
INDEXER_PORT=8787
POLL_INTERVAL_MS=2000
WEB_ORIGIN=http://localhost:5173

# Bind addresses for processes on the laptop.
# Compose overrides PIN_HOST and INDEXER_HOST to 0.0.0.0 and publishes 127.0.0.1 only.
PIN_HOST=127.0.0.1
PORT=8788

# Web app on the host. Empty indexer and gateway URLs mean same-origin /api and /ipfs.
VITE_CONTRACT_ADDRESS=
VITE_PUBLIC_ORIGIN=
VITE_INDEXER_URL=
VITE_IPFS_GATEWAY_URL=
RPC_URL=http://127.0.0.1:8545
PIN_URL=http://127.0.0.1:8788

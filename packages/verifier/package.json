{
  "name": "@proofchain/verifier",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "pretest": "pnpm --dir ../metadata build",
    "test": "pnpm run build && pnpm run typecheck && node --experimental-strip-types --test test/*.test.ts",
    "verify-batch": "node --experimental-strip-types bin/verify-batch.ts"
  },
  "dependencies": {
    "@ethereumjs/trie": "6.2.1",
    "@proofchain/metadata": "file:../metadata",
    "multiformats": "14.0.5",
    "viem": "2.57.13"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "typescript": "5.9.3"
  }
}
